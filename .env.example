# Copie para .env.local (nunca faça commit do .env.local).
# Todos os serviços abaixo têm plano gratuito. Veja docs/APIS.md.
# Formato: NOME=valor, sem aspas e sem comentário na mesma linha.
# Para enviar ao GitHub Actions: pnpm secrets:sincronizar (só envia as variáveis preenchidas).

# --- Banco (Supabase, plano gratuito) ---
# Painel: Project Settings → API Keys. Servem as chaves novas ou as legadas (aba "Legacy").
# URL: https://<ref-do-projeto>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# "Publishable key" (sb_publishable_…) ou a legada "anon"
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "Secret key" (sb_secret_…) ou a legada "service_role" — só servidor/GitHub Actions
SUPABASE_SERVICE_ROLE_KEY=

# --- Conflitos ---
# Conta myACLED; a senha é usada só para obter o token OAuth
ACLED_EMAIL=
ACLED_PASSWORD=
# appname aprovado pela ReliefWeb
RELIEFWEB_APPNAME=
# Se a API exigir (verificar documentação)
UCDP_ACCESS_TOKEN=
# Opcional
NASA_FIRMS_MAP_KEY=

# --- Governos ---
# Chave grátis em api.data.gov
CONGRESS_GOV_API_KEY=

# --- Arsenal / mídia ---
# Chave pública (presa ao domínio)
DVIDS_API_KEY=
# Identificação exigida pela Wikimedia; o contato público é definido na Fase 7
WIKIMEDIA_USER_AGENT=

# --- Tradução pt-BR ---
# DeepL API Free: a chave termina em ":fx"
DEEPL_API_KEY=
# Fallback auto-hospedado (opcional)
LIBRETRANSLATE_URL=
# Opcional, resumos automáticos
GEMINI_API_KEY=
