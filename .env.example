# Copie para .env.local (nunca faça commit do .env.local)
# Todos os serviços abaixo têm plano gratuito. Veja docs/APIS.md.

# --- Banco (Supabase, plano gratuito) ---
# Painel: Project Settings → API Keys. Servem as chaves novas ou as legadas (aba "Legacy").
NEXT_PUBLIC_SUPABASE_URL=           # https://<ref-do-projeto>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=      # "Publishable key" (sb_publishable_…) ou a legada "anon"
SUPABASE_SERVICE_ROLE_KEY=          # "Secret key" (sb_secret_…) ou a legada "service_role" — só servidor/GitHub Actions

# --- Conflitos ---
ACLED_EMAIL=                        # conta myACLED
ACLED_PASSWORD=                     # usado só para obter o token OAuth
RELIEFWEB_APPNAME=                  # appname aprovado pela ReliefWeb
UCDP_ACCESS_TOKEN=                  # se a API exigir (verificar documentação)
NASA_FIRMS_MAP_KEY=                 # opcional

# --- Governos ---
CONGRESS_GOV_API_KEY=               # chave grátis em api.data.gov

# --- Arsenal / mídia ---
DVIDS_API_KEY=                      # chave pública (presa ao domínio)
WIKIMEDIA_USER_AGENT="TEATRO-OPS/1.0 (+https://seu-dominio/fontes; contato@seu-dominio)"

# --- Tradução pt-BR ---
DEEPL_API_KEY=                      # plano Free (termina em :fx)
LIBRETRANSLATE_URL=                 # fallback auto-hospedado (opcional)
GEMINI_API_KEY=                     # opcional, resumos automáticos
